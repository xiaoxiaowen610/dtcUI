{
  "name": "forge-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n engine,studio -c cyan,magenta \"pnpm --filter @forge-ui/engine dev\" \"pnpm --filter @forge-ui/studio dev\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:api": "vitest run apps/engine",
    "test:ui": "vitest run apps/studio",
    "test:integration": "vitest run scripts",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm typecheck && pnpm --filter @forge-ui/engine build && pnpm --filter @forge-ui/studio build",
    "generate:flagship": "node --import tsx scripts/generate-flagship.ts",
    "validate:flagship": "node --import tsx scripts/validate-flagship.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm validate:flagship"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__generator": "^7.27.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.4",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
